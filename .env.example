# ------------------------------------------------------------------------------
# BharatAI Business OS - Environment Configuration
# ------------------------------------------------------------------------------

# Application Setup
APP_NAME="BharatAI Business OS"
APP_ENV=development # 'production' or 'development'
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_KEY=base64_bharatai_production_secret_key_849204820942048209

# Database Configuration (MySQL 8+ in production / SQLite supported in dev)
DB_CONNECTION=sqlite # 'mysql' or 'sqlite'
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storage/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

# Session & Security
SESSION_LIFETIME=120 # minutes
CSRF_TOKEN_EXPIRE=3600

# AI Provider API Keys (Stored server-side only - Never exposed to client)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_KEY=

# SMTP Mail Server Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@bharatai.com
MAIL_FROM_NAME="BharatAI Business OS"

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google-callback.php

# Payment Gateways (Razorpay / Stripe / Cashfree)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Storage & AWS S3 Configuration (Optional for cloud attachments)
STORAGE_DRIVER=local # 'local' or 's3'
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=

# Cron Job Secret
CRON_SECRET_KEY=bharatai_cron_secret_772038102
