# ==============================================================================
# BharatAI Business OS - Production Hosting Environment Configuration
# ==============================================================================

# Application Environment (production / development)
APP_NAME="BharatAI Business OS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_KEY=bharatai_prod_secret_key_change_me_random_32_chars

# Session Lifetime (seconds)
SESSION_LIFETIME=7200

# ==============================================================================
# DATABASE CONFIGURATION (cPanel MySQL / MariaDB / Cloud SQL)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_bharataidb
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your_strong_mysql_password_here

# ==============================================================================
# AI PROVIDERS & MODEL KEYS (Server-side Only)
# ==============================================================================
# Google Gemini (Default recommended - Fastest & most cost effective)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================================================
# SMTP EMAIL CONFIGURATION (cPanel Webmail, Brevo, SendGrid, Amazon SES)
# ==============================================================================
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USERNAME=notifications@yourdomain.com
SMTP_PASSWORD=your_email_password
SMTP_ENCRYPTION=ssl
MAIL_FROM_NAME="BharatAI Business OS"
MAIL_FROM_ADDRESS=notifications@yourdomain.com

# ==============================================================================
# PAYMENT GATEWAY CREDENTIALS (Razorpay / Stripe)
# ==============================================================================
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret

# ==============================================================================
# CRON JOB SECURITY KEY
# ==============================================================================
CRON_SECRET_KEY=bharatai_cron_secure_token_replace_me_4981923
